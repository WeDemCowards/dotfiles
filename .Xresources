! If you feel like wasting your time ricing, you should make your own modified 
! monokai.
! Darker Background
! Less "fun" primary colours
! green is too lime
! blue is too light
! red is too pink

! special
*foreground:   #f8f8f2
*background:   #0f0f0f
*cursorColor:  #f8f8f2

!black
*color0:       #272822
*color8:       #75715e

!red
!*color1:       #f92672
*color1:       #ff0000
*color9:       #ff0000

!green
*color2:       #a6e22e
*color10:      #a6e22e

!yellow
*color3:       #f4bf75
*color11:      #f4bf75

!blue
!*color4:       #66d9ef
*color4:       #3587ff
*color12:       #3587ff

!magenta
*color5:       #ae81ff
*color13:      #ae81ff

!cyan
*color6:       #a1efe4
*color14:      #a1efe4

!white
*color7:       #f8f8f2
*color15:      #f9f8f5



! font
URxvt*font: xft:CaskaydiaCoveNerdFont-Regular:pixelsize=18:antialias=true
URxvt*boldFont: xft:CaskaydiaCoveNerdFont-Bold:pixelsize=18:antialias=true
URxvt*italicFont: xft:CaskaydiaCoveNerdFont-Italic:pixelsize=18:antialias=true
URxvt*boldItalicFont: xft:CaskaydiaCoveNerdFont-BoldItalic:pixelsize=18:antialias=true
URxvt*letterSpace: -1
!URxvt*letterSpace: 0

!!! Geometry !!!
URxvt.geometry: 400x400

!!! Padding !!!
URxvt.internalBorder: 12

!!! Disbling annoying features !!!
URxvt.scrollBar: false
URxvt.iso14755: false
URxvt.iso14755_52: false
URxvt.keysym.Control-l: command:\033c

!!! Mouse Size !!!
Xcursor.size: 26

!!! Extensions !!!
URxvt.perl-ext-common: default,resize-font
URxvt.keysym.C-minus: resize-font:smaller
URxvt.keysym.C-plus: resize-font:bigger
